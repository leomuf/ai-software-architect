{
  "$comment": "SPDX-FileCopyrightText: 2026 Leonardo Muffato (AUTOSOFT Engineering - www.autosoft-engineering.de); SPDX-License-Identifier: MIT",
  "$defs": {
    "ArchitectureContract": {
      "additionalProperties": false,
      "properties": {
        "architecture_style": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture Style"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "maxItems": 200,
          "title": "Components",
          "type": "array"
        },
        "decision_ids": {
          "items": {
            "pattern": "^ADR-[0-9]{3}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Decision Ids",
          "type": "array"
        },
        "dependency_rules": {
          "items": {
            "$ref": "#/$defs/DependencyRule"
          },
          "maxItems": 500,
          "title": "Dependency Rules",
          "type": "array"
        },
        "external_boundaries": {
          "items": {
            "$ref": "#/$defs/ExternalBoundary"
          },
          "maxItems": 100,
          "title": "External Boundaries",
          "type": "array"
        },
        "prohibited_practices": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Prohibited Practices",
          "type": "array"
        },
        "quality_attributes": {
          "items": {
            "$ref": "#/$defs/QualityAttribute"
          },
          "maxItems": 20,
          "title": "Quality Attributes",
          "type": "array"
        },
        "required_practices": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Required Practices",
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "unresolved_questions": {
          "items": {
            "$ref": "#/$defs/ClarificationQuestion"
          },
          "maxItems": 50,
          "title": "Unresolved Questions",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "scope"
      ],
      "title": "ArchitectureContract",
      "type": "object"
    },
    "ArchitectureDecision": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Assumptions",
          "type": "array"
        },
        "considered_option_ids": {
          "items": {
            "pattern": "^OPT-[0-9]{3}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Considered Option Ids",
          "type": "array"
        },
        "context": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "decision": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "drivers": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Drivers",
          "type": "array"
        },
        "id": {
          "pattern": "^ADR-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "negative_consequences": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Negative Consequences",
          "type": "array"
        },
        "positive_consequences": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Positive Consequences",
          "type": "array"
        },
        "selected_option_id": {
          "anyOf": [
            {
              "pattern": "^OPT-[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "supersedes": {
          "items": {
            "pattern": "^ADR-[0-9]{3}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Supersedes",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "validation_criteria": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Validation Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "context",
        "drivers",
        "considered_option_ids",
        "decision",
        "validation_criteria"
      ],
      "title": "ArchitectureDecision",
      "type": "object"
    },
    "ArchitectureDecisionArtifact": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ArchitectureDecision"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "decision"
      ],
      "title": "ArchitectureDecisionArtifact",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "decision_impact": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Decision Impact",
          "type": "string"
        },
        "id": {
          "pattern": "^Q-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "decision_impact"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "owns_data": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Owns Data",
          "type": "array"
        },
        "public_interfaces": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Public Interfaces",
          "type": "array"
        },
        "responsibility": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "responsibility"
      ],
      "title": "Component",
      "type": "object"
    },
    "DependencyRule": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "description": "Use allow for a direct permitted dependency, deny for a prohibited dependency, and allow-via-interface only when via_interface names the required public interface.",
          "enum": [
            "allow",
            "deny",
            "allow-via-interface"
          ],
          "title": "Policy",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Target",
          "type": "string"
        },
        "via_interface": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required only when policy is allow-via-interface; omit this field for allow and deny.",
          "title": "Via Interface"
        }
      },
      "required": [
        "source",
        "target",
        "policy",
        "rationale"
      ],
      "title": "DependencyRule",
      "type": "object"
    },
    "ExternalBoundary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "responsibility": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "responsibility"
      ],
      "title": "ExternalBoundary",
      "type": "object"
    },
    "QualityAttribute": {
      "additionalProperties": false,
      "properties": {
        "measurable_signal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurable Signal"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "name",
        "priority",
        "rationale"
      ],
      "title": "QualityAttribute",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One atomically validated architecture record-and-handoff candidate.",
  "properties": {
    "coding_handoff": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Coding Handoff",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/ArchitectureContract"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ArchitectureDecisionArtifact"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "project_context": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Project Context",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "decisions",
    "project_context",
    "coding_handoff"
  ],
  "title": "ArchitectureArtifactBundle",
  "type": "object"
}
