{
  "description": "Recommended local guardrails for AI Software Architect: accept direct skill or substantive plugin-page requests, correct an empty plugin selection, resolve explicit canonical reference names, continue one bounded clarification or decision reply, keep architect inspection static and application code unchanged, validate stable visible option rendering when present, and reject leaked internal response markers. Semantic mode remains a host-model responsibility. No model calls or network calls; exact hook definitions are included in the package, and source and tests are linked from the plugin page when repository access is available.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-mcp/ai-architect-mcp.exe\" --codex-hook",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-mcp\\ai-architect-mcp.exe\" --codex-hook",
            "timeout": 5,
            "statusMessage": "Routing the architecture workflow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write|WebSearch|web_search|search_query|web__run|.*(validate_complete_architecture_contract|scan_generated_architecture_artifact|analyze_python_dependencies|check_python_architecture_boundaries).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-mcp/ai-architect-mcp.exe\" --codex-hook",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-mcp\\ai-architect-mcp.exe\" --codex-hook",
            "timeout": 5,
            "statusMessage": "Checking read-only architecture tool use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-mcp/ai-architect-mcp.exe\" --codex-hook",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-mcp\\ai-architect-mcp.exe\" --codex-hook",
            "timeout": 5,
            "statusMessage": "Validating the architecture response"
          }
        ]
      }
    ]
  }
}
