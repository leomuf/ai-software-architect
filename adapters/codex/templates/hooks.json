{
  "description": "Recommended local guardrails for AI Software Architect: route and continue the workflow, keep inspection static and application code unchanged, validate complete architecture bundles before writes, verify persisted artifacts afterward, restore minimal typed state after compaction, validate stable visible option rendering, and reject leaked internal markers. Semantic mode remains a host-model responsibility. No model calls, network calls, or persistent process; exact source and tests are linked from the plugin page.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-runtime/ai-architect-runtime.exe\" --codex-hook --event UserPromptSubmit",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-runtime\\ai-architect-runtime.exe\" --codex-hook --event UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Routing the architecture workflow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write|WebSearch|web_search|search_query|web__run)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-runtime/ai-architect-runtime.exe\" --codex-hook --event PreToolUse",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-runtime\\ai-architect-runtime.exe\" --codex-hook --event PreToolUse",
            "timeout": 5,
            "statusMessage": "Checking read-only architecture tool use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-runtime/ai-architect-runtime.exe\" --codex-hook --event PostToolUse",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-runtime\\ai-architect-runtime.exe\" --codex-hook --event PostToolUse",
            "timeout": 5,
            "statusMessage": "Verifying architecture artifact postconditions"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-runtime/ai-architect-runtime.exe\" --codex-hook --event PostCompact",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-runtime\\ai-architect-runtime.exe\" --codex-hook --event PostCompact",
            "timeout": 5,
            "statusMessage": "Restoring the architecture workflow checkpoint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/runtime/windows-x86_64/ai-architect-runtime/ai-architect-runtime.exe\" --codex-hook --event Stop",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\windows-x86_64\\ai-architect-runtime\\ai-architect-runtime.exe\" --codex-hook --event Stop",
            "timeout": 5,
            "statusMessage": "Validating the architecture response"
          }
        ]
      }
    ]
  }
}
